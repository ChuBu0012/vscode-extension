{
  "name": "quotadeck",
  "displayName": "QuotaDeck — AI Usage & Limits",
  "description": "Monitor 5-hour/weekly AI coding quotas, rate limits, and API credit balances for Antigravity, Claude Code, Codex, OpenRouter, DeepSeek, Cline, and custom endpoints.",
  "version": "0.3.1",
  "publisher": "pornput-s",
  "author": {
    "name": "pornput.s"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0e1726",
    "theme": "dark"
  },
  "homepage": "https://github.com/ChuBu0012/vscode-extension/tree/main/extensions/quotadeck#readme",
  "bugs": {
    "url": "https://github.com/ChuBu0012/vscode-extension/issues"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChuBu0012/vscode-extension"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "quota",
    "usage",
    "limits",
    "rate-limit",
    "claude",
    "claude-code",
    "codex",
    "antigravity",
    "openrouter",
    "deepseek",
    "cline",
    "llm",
    "ai-agent",
    "status-bar",
    "monitoring",
    "dashboard",
    "api-credits"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quotadeck.openDashboard",
        "title": "Open Dashboard",
        "category": "QuotaDeck"
      },
      {
        "command": "quotadeck.refresh",
        "title": "Refresh Usage",
        "category": "QuotaDeck"
      },
      {
        "command": "quotadeck.clearHistory",
        "title": "Clear History",
        "category": "QuotaDeck"
      },
      {
        "command": "quotadeck.connectProvider",
        "title": "Add Agent / Provider API Key",
        "category": "QuotaDeck"
      },
      {
        "command": "quotadeck.disconnectProvider",
        "title": "Disconnect Provider API Key",
        "category": "QuotaDeck"
      }
    ],
    "configuration": {
      "title": "QuotaDeck",
      "properties": {
        "quotadeck.pollingIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 3600,
          "description": "Baseline polling interval in seconds for refreshing usage quotas."
        },
        "quotadeck.smartPolling": {
          "type": "boolean",
          "default": true,
          "description": "Automatically speed up polling to 1 minute when quota or balance drops, and relax back after 3 unchanged checks."
        },
        "quotadeck.displayMode": {
          "type": "string",
          "enum": ["remaining", "used"],
          "default": "remaining",
          "description": "Display quota percentages as remaining ('left') or consumed ('used') across all providers."
        },
        "quotadeck.statusBarProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["agy-gemini", "claude", "codex"],
          "description": "Which provider quotas to show in the Status Bar (e.g. 'agy-gemini', 'agy-claude', 'claude', 'codex', 'openrouter', 'deepseek', 'cline', or 'custom:<id>')."
        },
        "quotadeck.lowThresholdPct": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 90,
          "description": "Remaining quota percentage threshold at or below which warning highlights and Low status filters activate."
        },
        "quotadeck.lowBalanceUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Remaining USD balance threshold at or below which uncapped balance providers trigger low-balance warnings."
        },
        "quotadeck.budgets": {
          "type": "object",
          "default": {},
          "properties": {
            "openrouter": {
              "type": "number",
              "minimum": 0.01,
              "description": "Optional USD budget cap for OpenRouter to compute remaining percentage."
            },
            "deepseek": {
              "type": "number",
              "minimum": 0.01,
              "description": "Optional USD budget cap for DeepSeek to compute remaining percentage."
            },
            "cline": {
              "type": "number",
              "minimum": 0.01,
              "description": "Optional USD budget cap for Cline balance to compute remaining percentage."
            }
          },
          "description": "Optional USD budget caps per balance-based provider for calculating percentage bars and low-balance warnings."
        },
        "quotadeck.customProviders": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["id", "name", "kind", "valuePath"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "shortCode": { "type": "string" },
              "kind": { "type": "string", "enum": ["http", "cli"] },
              "url": { "type": "string" },
              "method": { "type": "string", "enum": ["GET", "POST"] },
              "headers": { "type": "object" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "timeoutMs": { "type": "number" },
              "secretKey": { "type": "string" },
              "valueType": { "type": "string", "enum": ["percentage", "used_percentage", "balance_usd"] },
              "valuePath": { "type": "string" },
              "resetPath": { "type": "string" },
              "budgetCapUsd": { "type": "number" }
            }
          },
          "description": "Custom HTTP JSON or CLI usage providers."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile:prod",
    "compile": "bun esbuild.js",
    "compile:prod": "bun esbuild.js --production",
    "watch": "bun esbuild.js --watch",
    "package": "bun run compile:prod && bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
